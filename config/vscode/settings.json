{
    "task.allowAutomaticTasks": "on",
    "workbench.colorTheme": "Dark Modern",
    "workbench.startupEditor": "none",
    "workbench.activityBar.location": "top",
    "workbench.tips.enabled": false,
    "workbench.remoteIndicator.showExtensionRecommendations": false,
    "workbench.editor.tabSizing": "fixed",
    "workbench.editor.tabSizingFixedMaxWidth": 180,
    "workbench.editor.useModal": "off",
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#000000",
        "titleBar.inactiveBackground": "#000000",
        "editorGroupHeader.tabsBackground": "#000000",
        "tab.inactiveBackground": "#000000",
        "editor.background": "#000000",
        "editorIndentGuide.background1": "#2A2A2A",
        "editorIndentGuide.activeBackground1": "#666666",
        "sideBar.background": "#000000",
        "terminal.background": "#07000e",
        "statusBar.background": "#000000",
    },
    "editor.fontFamily": "\"JetBrains Mono NL Light\", \"UDEV Gothic 35JPDOC Regular\"",
    "editor.fontSize": 17,
    "editor.lineNumbers": "on",
    "editor.renderWhitespace": "trailing",
    "editor.inlayHints.enabled": "off",
    "editor.inlineSuggest.enabled": false,
    "editor.minimap.enabled": true,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.showSlider": "always",
    "editor.wordWrap": "bounded",
    "editor.formatOnSave": true,
    "editor.dragAndDrop": false,
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "files.eol": "\n",
    "files.associations": {
        "*.toml": "ini",
        "*.lock": "ini"
    },
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "always",
    "terminal.integrated.fontFamily": "\"Bizin Gothic NF Regular\"",
    "terminal.integrated.fontSize": 21,
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.initialHint": false,
    "vscode-neovim.useWSL": true,
    "vscode-neovim.neovimExecutablePaths.linux": "/home/linuxbrew/.linuxbrew/bin/nvim",
    "vscode-neovim.neovimInitVimPaths.linux": "~/dotfiles/.config/nvim/init.lua",
    "vscode-neovim.compositeKeys": {
        "jk": {
            "command": "vscode-neovim.escape",
        },
    },
    "vscode-neovim.compositeTimeout": 100,
    "chat.disableAIFeatures": true,
    "chat.mcp.gallery.enabled": true,
    "chatgpt.localeOverride": "en-US",
    "chatgpt.openOnStartup": true,
    "chatgpt.composerEnterBehavior": "cmdAlways",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "extensions.ignoreRecommendations": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "accessibility.verbosity.emptyEditorHint": false,
    "[markdown]": {
        "editor.formatOnSave": false
    },
    "claudeCode.allowDangerouslySkipPermissions": true,
    "claudeCode.initialPermissionMode": "bypassPermissions",
    "chatgpt.followUpQueueMode": "steer"
}