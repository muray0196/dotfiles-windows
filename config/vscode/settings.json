{
    "chat.disableAIFeatures": true,
    "editor.inlineSuggest.enabled": false,
    "chatgpt.localeOverride": "en-US",
    "workbench.editor.tabSizing": "fixed",
    "workbench.editor.tabSizingFixedMaxWidth": 180,
    "editor.minimap.enabled": true,
    "editor.formatOnSave": true,
    "editor.dragAndDrop": false,
    "git.confirmSync": false,
    "explorer.confirmDragAndDrop": false,
    "editor.lineNumbers": "on",
    "editor.renderWhitespace": "trailing",
    "editor.fontFamily": "\"JetBrains Mono NL Light\", \"UDEV Gothic 35JPDOC Regular\"",
    "editor.fontSize": 17,
    "terminal.integrated.fontFamily": "\"Bizin Gothic NF Regular\", \"consoals\"",
    "terminal.integrated.fontSize": 21,
    "vscode-neovim.useWSL": true,
    "vscode-neovim.neovimExecutablePaths.linux": "/home/linuxbrew/.linuxbrew/bin/nvim",
    "vscode-neovim.neovimInitVimPaths.linux": "~/dotfiles/.config/nvim/init.lua",
    "vscode-neovim.compositeKeys": {
        "jk": {
            "command": "vscode-neovim.escape",
        },
    },
    "vscode-neovim.compositeTimeout": 100,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "files.associations": {
        "*.toml": "ini",
    },
    "git.openRepositoryInParentFolders": "always",
    "workbench.startupEditor": "none",
    "workbench.remoteIndicator.showExtensionRecommendations": false,
    "extensions.ignoreRecommendations": true,
    "workbench.activityBar.location": "top",
    "chatgpt.openOnStartup": true,
    "workbench.tips.enabled": false,
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.initialHint": false,
    "editor.inlayHints.enabled": "off",
    "accessibility.verbosity.emptyEditorHint": false,
    "files.eol": "\n",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "chat.mcp.gallery.enabled": true,
    "explorer.confirmDelete": false,
    "security.allowedUNCHosts": [
        "wsl$"
    ],
    "chatgpt.composerEnterBehavior": "cmdAlways",
    "editor.minimap.renderCharacters": false,
    "editor.minimap.showSlider": "always",
    "workbench.colorTheme": "Dark+ Pure Black (OLED)",
    "workbench.colorCustomizations": {
        "terminal.background": "#07000e",
        "editorIndentGuide.background1": "#2A2A2A",
        "editorIndentGuide.background2": "#2A2A2A",
        "editorIndentGuide.background3": "#2A2A2A",
        "editorIndentGuide.background4": "#2A2A2A",
        "editorIndentGuide.background5": "#2A2A2A",
        "editorIndentGuide.background6": "#2A2A2A",
        "editorIndentGuide.activeBackground1": "#666666",
        "editorIndentGuide.activeBackground2": "#666666",
        "editorIndentGuide.activeBackground3": "#666666",
        "editorIndentGuide.activeBackground4": "#666666",
        "editorIndentGuide.activeBackground5": "#666666",
        "editorIndentGuide.activeBackground6": "#666666"
    },
    "editor.wordWrap": "bounded"
}